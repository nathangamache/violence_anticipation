{
  "embeddings_dir": "data/processed/vlm_emb",
  "labels_dir": "data/processed/labels_multih",
  "train_index": "train_index.json",
  "val_index": "val_index.json",
  "test_index": "test_index.json",
  "source_filter": "xd_violence",
